{
    "setup-worktree-windows": [
        "bun install",
        "cp \"$env:ROOT_WORKTREE_PATH/server.crt\" \"server.crt\"",
        "cp \"$env:ROOT_WORKTREE_PATH/server.key\" \"server.key\"",
        "cp \"$env:ROOT_WORKTREE_PATH/lxa.crt\" \"lxa.crt\"",
        "cp \"$env:ROOT_WORKTREE_PATH/lxa.pfx\" \"lxa.pfx\"",
        "cp \"$env:ROOT_WORKTREE_PATH/.env\" \".env\""
    ]
}